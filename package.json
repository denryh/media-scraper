{
  "name": "media-scraper",
  "private": true,
  "workspaces": ["backend", "frontend", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter frontend lint",
    "test:load": "bun run --filter backend --elide-lines=50 test:load",
    "test:load:fixture": "bun run --filter backend test:load:fixture",
    "test:load:capture": "bun run --filter backend --elide-lines=50 test:load:capture"
  }
}
